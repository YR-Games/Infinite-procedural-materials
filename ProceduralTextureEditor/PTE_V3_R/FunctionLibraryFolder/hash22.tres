[ext_resource type="Script" uid="uid://dxcnvm1ttksge" path="res://PTE_V3_R/resources/function_data.gd" id="1_05bf8"]

[resource]
script = ExtResource("1_05bf8")
function_name = "hash22"
code = "vec2 hash22(vec2 p)
{
	vec3 p3 = fract(vec3(p.xyx) * vec3(.1031, .1030, .0973));
    p3 += dot(p3, p3.yzx+33.33);
    return fract((p3.xx+p3.yz)*p3.zy);
}"
metadata/_custom_type_script = "uid://dxcnvm1ttksge"
