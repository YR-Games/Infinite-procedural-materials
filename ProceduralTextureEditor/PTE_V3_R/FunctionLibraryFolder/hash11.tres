[resource]
script = ExtResource("1_ju86x")
function_name = "hash11"
code = "float hash11(float p)
{
    p = fract(p * .1031);
    p *= p + 33.33;
    p *= p + p;
    return fract(p);
}"
metadata/_custom_type_script = "uid://dxcnvm1ttksge"
