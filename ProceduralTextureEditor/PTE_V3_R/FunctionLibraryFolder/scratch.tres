[ext_resource type="Script" uid="uid://dxcnvm1ttksge" path="res://PTE_V3_R/resources/function_data.gd" id="1_45i5h"]

[resource]
script = ExtResource("1_45i5h")
function_name = "scratch"
code = "float scratch(vec2 p, float f, float thickness, float wavyness) {
	//const float THICKNESS = 0.0;
	//const float WAVYNESS = 0.5;

	vec2 i = floor(p);
	vec2 h = hash22(i) * vec2(3104.0, 554.0);

	p = (p - i) * 2.0 - 1.0;
	p = p * cos(h.x + h.y) + vec2(-p.y, p.x) * sin(h.x + h.y);
	p += sin(h.x - h.y);

	float x = abs(p.x - cos(h.x + p.y * 1.57) * wavyness);
	x = 1.0 - smoothstep(thickness - f, thickness + f, x);
	x *= p.y * 0.5 + 0.5;

	return x;
}"
required_functions = ["hash22"]
metadata/_custom_type_script = "uid://dxcnvm1ttksge"
