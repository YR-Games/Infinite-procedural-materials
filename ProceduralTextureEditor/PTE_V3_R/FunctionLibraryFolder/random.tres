[ext_resource type="Script" uid="uid://dxcnvm1ttksge" path="res://PTE_V3_R/resources/function_data.gd" id="1_euod2"]

[resource]
script = ExtResource("1_euod2")
function_name = "random"
code = "	float random(in vec2 st) {
			vec3 p3  = fract(vec3(st.xyx) * .1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
	}"
metadata/_custom_type_script = "uid://dxcnvm1ttksge"
