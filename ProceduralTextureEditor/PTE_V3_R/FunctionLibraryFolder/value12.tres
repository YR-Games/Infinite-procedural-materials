[gd_resource type="Resource" script_class="FunctionData" format=3 uid="uid://c54xk4bfx1n12"]

[ext_resource type="Script" uid="uid://dxcnvm1ttksge" path="res://PTE_V3_R/resources/function_data.gd" id="1_dlcf0"]

[resource]
script = ExtResource("1_dlcf0")
function_name = "value12"
code = "float value12(vec2 p) {
	vec2 i = floor(p);
	vec2 f = p - i;
	f *= f * (3.0 - 2.0 * f);
	float res = mix(
			mix(hash12(i), hash12(i + vec2(1.0, 0.0)), f.x),
			mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0)), f.x), f.y);
	return res;
}"
required_functions = ["hash12"]
metadata/_custom_type_script = "uid://dxcnvm1ttksge"
