[ext_resource type="Script" uid="uid://dxcnvm1ttksge" path="res://PTE_V3_R/resources/function_data.gd" id="1_boalo"]

[resource]
script = ExtResource("1_boalo")
function_name = "fbm"
code = "float fbm( in vec2 x, in float H, in int numOct )
{    
    float G = exp2(-H);
    float f = 1.0;
    float a = 1.0;
    float t = 0.0;
    for( int i=0; i<numOct; i++ )
    {
        t += a*snoise(f*x);
        f *= 2.;
        a *= G;
    }
    return t;
}"
required_functions = ["snoise"]
metadata/_custom_type_script = "uid://dxcnvm1ttksge"
