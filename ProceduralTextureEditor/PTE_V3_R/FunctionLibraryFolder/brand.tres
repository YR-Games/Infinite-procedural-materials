[ext_resource type="Script" uid="uid://dxcnvm1ttksge" path="res://PTE_V3_R/resources/function_data.gd" id="1_j87wi"]

[resource]
script = ExtResource("1_j87wi")
function_name = "brand"
code = "float brand( in float x )
{
    // setup
    float i = floor(x);
    float f = fract(x);
    float s = sign(fract(x/2.0)-0.5);

    // use some hash to create a random value k in [0..1] from i
    //float k = hash(uint(i));
  //float k = 0.5+0.5*sin(i);
    float k = fract(i*.1731);

    // quartic polynomial
        return 0.5 * s * f * (f - 1.0) * ((16.0 * k - 4.0) * f * (f - 1.0) - 1.0) + 0.5;
}"
metadata/_custom_type_script = "uid://dxcnvm1ttksge"
