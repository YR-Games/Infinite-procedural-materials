[ext_resource type="Script" uid="uid://dxcnvm1ttksge" path="res://PTE_V3_R/resources/function_data.gd" id="1_s5b8e"]

[resource]
script = ExtResource("1_s5b8e")
function_name = "vcm"
code = "float vcm(vec2 uv, float time) {
    vec2 i_uv = floor(uv);
    vec2 f_uv = fract(uv);
    
    float d1 = 1e5; // smallest distance
    float d2 = 1e5; // second smallest distance
    
    for (int j = -1; j <= 1; j++) {
        for (int i = -1; i <= 1; i++) {
            vec2 neighbor = vec2(float(i), float(j));
            vec2 point = hash22(i_uv + neighbor);
            point = 0.5 + 0.5 * sin(time + TAU * point);  // as in original code
            
            vec2 diff = neighbor + point - f_uv;
            float dist = length(diff);

            if (dist < d1) {
                d2 = d1;
                d1 = dist;
            } else if (dist < d2) {
                d2 = dist;
            }
        }
    }
    float clearance = d1 + d2;
    return clearance*d1;
}"
required_functions = ["hash22"]
metadata/_custom_type_script = "uid://dxcnvm1ttksge"
