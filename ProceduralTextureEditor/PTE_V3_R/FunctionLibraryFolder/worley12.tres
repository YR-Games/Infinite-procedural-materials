[ext_resource type="Script" uid="uid://dxcnvm1ttksge" path="res://PTE_V3_R/resources/function_data.gd" id="1_w0vkn"]

[resource]
script = ExtResource("1_w0vkn")
function_name = "worley12d"
code = "float worley12(vec2 p) {
	vec2 i = floor(p);
	p -= i;
	float w = 1e6;
	for (float x = -1.0; x <= 1.0; ++x) {
		for (float y = -1.0; y <= 1.0; ++y) {
			vec2 c = p - vec2(x, y) - hash12(i + vec2(x, y));
			w = min(w, dot(c, c));
		}
	}
	return 1.0 - sqrt(w);
}"
required_functions = ["hash12"]
metadata/_custom_type_script = "uid://dxcnvm1ttksge"
