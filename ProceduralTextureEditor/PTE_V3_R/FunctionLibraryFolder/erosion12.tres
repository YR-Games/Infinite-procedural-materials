[ext_resource type="Script" uid="uid://dxcnvm1ttksge" path="res://PTE_V3_R/resources/function_data.gd" id="1_k6jwd"]

[resource]
script = ExtResource("1_k6jwd")
function_name = "erosion12"
code = "vec3 erosion12(vec2 p) {
	vec3 nd = perlin12d(p);
	float strength = 0.25;
	float freq = 8.0;
	float total = 1.0;
	for (int i = 0; i < 4; i++) {
		float len2 = dot(nd.yz, nd.yz);
		nd += gullies(p * freq, nd.yz * pow(len2, 0.5 * (0.5 - 1.0))) * strength * vec3(1.0, freq, freq);
		total += strength;
		strength *= 0.5;
		freq *= 2.0;
	}
	return nd / total;
}"
required_functions = ["perlin12d", "gullies"]
metadata/_custom_type_script = "uid://dxcnvm1ttksge"
