[resource]
script = ExtResource("2_2321s")
function_name = "colorRamp"
function = "vec4 colorRamp(float value, vec3 palette[8]) {
    const int SIZE = 8;

    float t = clamp(value, 0.0, 1.0) * float(SIZE - 1);

    int i = int(floor(t));
    i = clamp(i, 0, SIZE - 2);

    float f = fract(t);

    return vec4(mix(palette[i], palette[i + 1], f), 1.0);
}"
parameters = Dictionary[String, ExtResource("1_hb2ue")]({
"palette": SubResource("Resource_hi3c7")
})
metadata/_custom_type_script = "uid://db062eko2a4ko"
