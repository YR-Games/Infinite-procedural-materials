[resource]
script = ExtResource("2_xjgbn")
generator_id = "cellnoise"
generator_name = "CellNoise"
preview_shader = ExtResource("2_kjapn")
function_snippet = "#define cos1 1.0049000034
#define sin1 0.4474103074

float sphereGrid(vec2 uv) {
    vec2 squaregrid = fract(uv) - 0.5;
    float spheregrid = dot(squaregrid, squaregrid);
    return spheregrid;
}

float cellTiling(vec2 uv) {
    float c = sphereGrid(uv);
    mat2 m = mat2(vec2(cos1, -sin1), vec2(sin1, cos1));
    uv *= m;
    c = min(c, sphereGrid(uv));
    uv *= m;
    c = min(c, sphereGrid(uv));
    return c;
}

float cfbm(vec2 x, float H, int numOct) {
    float G = exp2(-H);
    float f = 1.0;
    float a = 1.0;
    float t = 0.0;
    for (int i = 0; i < numOct; i++) {
        t += a * cellTiling(f * x);
        f *= 2.0;
        a *= G;
    }
    return t;
}

float cellNoise(vec2 uv, float scale, float chaos, int numOctaves) {
    return cfbm(uv * scale, chaos, numOctaves);
}"
parameters = Array[ExtResource("1_l88wu")]([SubResource("Resource_dk4g2"), SubResource("Resource_eucx8"), SubResource("Resource_t6knw")])
metadata/_custom_type_script = "uid://b2t4rdfk1u1es"
